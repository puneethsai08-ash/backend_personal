{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robobench.dev/schemas/component.schema.json",
  "title": "RoboBench Component Schema",
  "description": "Common component definition format for RoboBench.",
  "type": "object",
  "required": ["component"],
  "additionalProperties": false,

  "properties": {
    "component": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "manufacturer",
        "pins"
      ],

      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "category": {
          "type": "string",
          "enum": [
            "microcontroller",
            "sensor",
            "actuator"
          ]
        },

        "manufacturer": {
          "type": "string",
          "minLength": 1
        },

        "model": {
          "type": "string"
        },

        "description": {
          "type": "string"
        },

        "electrical": {
          "type": "object",
          "properties": {
            "logic_voltage": {
              "type": "number",
              "exclusiveMinimum": 0
            },

            "input_voltage_min": {
              "type": "number",
              "minimum": 0
            },

            "input_voltage_max": {
              "type": "number",
              "exclusiveMinimum": 0
            },

            "operating_current_min": {
              "type": "number",
              "minimum": 0
            },

            "operating_current_max": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": true
        },

        "pins": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "object",
            "required": ["id", "type", "functions"],

            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },

              "number": {
                "type": "integer",
                "minimum": 1
              },

              "type": {
                "type": "string",
                "enum": [
                  "gpio",
                  "power",
                  "ground",
                  "analog",
                  "digital",
                  "communication"
                ]
              },

              "direction": {
                "type": "string",
                "enum": [
                  "input",
                  "output",
                  "bidirectional",
                  "power"
                ]
              },

              "functions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },

              "voltage": {
                "type": "number",
                "minimum": 0
              }
            },

            "additionalProperties": true
          }
        },

        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },

      "additionalProperties": true
    }
  }
}
