{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hardware-CAD Binding",
  "type": "object",
  "required": ["id", "name", "root_link", "links", "joints", "component_bindings"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "root_link": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "asset"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "asset": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "joints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "parent_link", "child_link"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "type": {
            "enum": ["fixed", "revolute", "continuous", "prismatic"]
          },
          "parent_link": {
            "type": "string",
            "minLength": 1
          },
          "child_link": {
            "type": "string",
            "minLength": 1
          },
          "axis": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 3,
            "maxItems": 3
          },
          "range": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "component_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["instance_id", "component_id", "link_id", "pin_bindings"],
        "additionalProperties": false,
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "link_id": {
            "type": "string",
            "minLength": 1
          },
          "joint_id": {
            "type": ["string", "null"]
          },
          "pin_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["pin_id", "role"],
              "additionalProperties": false,
              "properties": {
                "pin_id": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": ["control", "sensor", "signal"]
                }
              }
            }
          }
        }
      }
    }
  }
}
